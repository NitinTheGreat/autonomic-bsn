# --- datasets: never commit PAMAP2 (~1.6 GB) ---
# Ignore the CONTENTS, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, and data/raw/README.md must stay tracked
# because it documents the download commands.
data/raw/*
!data/raw/README.md

# --- generated results (regenerate with the phase scripts) ---
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, and the paper write-ups must stay tracked.
results/*
frontend/results/
!results/paper/
results/paper/*
!results/paper/*.md

# --- secrets: never commit API keys ---
.env
.env.*
!.env.example

# --- model weights ---
*.gguf
*.bin
*.safetensors

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
