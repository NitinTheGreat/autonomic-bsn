# Copy this file to .env and fill in your values:
#     cp .env.example .env          (PowerShell:  Copy-Item .env.example .env)
#
# .env is gitignored and must never be committed. Real environment variables
# take precedence over anything set here. Scripts load .env automatically --
# no python-dotenv dependency needed.


# ===========================================================================
# BACKEND SELECTION
# ===========================================================================
# LLM_PROVIDER and BSN_BACKEND are equivalent and both override `backend:` in
# configs/models.yaml, so you can switch stacks without editing a tracked file.
# If both are set, BSN_BACKEND wins.
#
#   openai      TRUE logprobs   paid      -- paper results, final experiments
#   cerebras    TRUE logprobs   free      -- development, testing, demos
#   llamacpp    TRUE logprobs   local     -- free, no API key
#   vllm        TRUE logprobs   local     -- free, no API key
#   anthropic   NO logprobs -- self-consistency sampling; must be selected
#               explicitly and is refused while require_logprobs: true
#   vertex      PAUSED pending credentials
#   gemini      PAUSED -- Developer API rejects logprobs on every model
#   auto        walk fallback_order (openai -> cerebras -> llamacpp -> vllm)
LLM_PROVIDER=openai


# ===========================================================================
# OpenAI -- PAID. Use for paper results and final experiments.
# ===========================================================================
# https://platform.openai.com/api-keys
# VERIFIED 2026-08-30: gpt-4o returns logprobs.content[0].top_logprobs.
# BASE_URL and MODEL override configs/models.yaml when set.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o


# ===========================================================================
# Cerebras -- FREE. Use for development, testing and demos.
# ===========================================================================
# https://cloud.cerebras.ai
# OpenAI-compatible, so it reuses the same client code path unchanged.
# VERIFIED 2026-08-30: gemma-4-31b returns real top_logprobs.
#
# NOTE: its distribution is far more peaked than gpt-4o's (top token at
# logprob -0.0 vs -0.577 on the same probe). A near-saturated distribution has
# little headroom to express degraded confidence, which matters for this
# project specifically -- develop on Cerebras, but measure on OpenAI.
#
# NOTE: the free tier rate-limits below a 150-window run's call rate. The
# client retries with exponential backoff (request.max_retries in models.yaml).
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gemma-4-31b


# ===========================================================================
# OPTIONAL -- Anthropic (self-consistency, NOT logprobs)
# ===========================================================================
# https://console.anthropic.com/settings/keys
#
# The Messages API has no logprobs/top_logprobs -- no parameter, no model.
# This backend samples the same prompt k times (default k=10, temperature 0.7)
# and uses the vote fraction per label. Results are tagged
# confidence_method="self_consistency" and MUST NOT be pooled with logprob
# results. Costs k x inference. Robustness check only.
#
# To use it you must select it explicitly AND set require_logprobs: false in
# configs/models.yaml -- otherwise the run refuses, by design.
ANTHROPIC_API_KEY=


# ===========================================================================
# PAUSED -- Vertex AI (Google Cloud)
# ===========================================================================
# Parked pending credentials. Backend code is implemented and mock-verified but
# has never run live. See walkthrough/phase1.md 3.2.
#   1. GCP project with billing enabled
#   2. Enable the Vertex AI API
#   3. Service-account JSON key with the "Vertex AI User" role (keep it OUTSIDE
#      the repo), or `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=


# ===========================================================================
# PAUSED -- Gemini Developer API
# ===========================================================================
# VERIFIED NOT USABLE: every model returns
# 400 "Logprobs is not enabled for this model" on this surface, while
# returning 200 for ordinary generation. Changing the model does not help.
# Kept only so the finding is not rediscovered the hard way.
GEMINI_API_KEY=


# ===========================================================================
# OPTIONAL -- local backends
# ===========================================================================
# No API key needed; addressed by URL in configs/models.yaml.
# Start llama.cpp with:  llama-server -m <gguf> -c 4096 --port 8080
