# Copy this file to .env and fill in your values:
#     cp .env.example .env          (PowerShell:  Copy-Item .env.example .env)
#
# .env is gitignored and must never be committed. Real environment variables
# take precedence over anything set here, so you can also just export a key.
# Scripts load .env automatically -- no python-dotenv dependency needed.


# ===========================================================================
# REQUIRED for the default backend (`vertex` in configs/models.yaml)
# ===========================================================================
# Vertex AI is the Google Cloud surface where Gemini logprobs are available.
# The Gemini Developer API (AI Studio keys) is NOT usable for this project --
# it rejects logprobs on every model. See the README.
#
# Setup, once:
#   1. Create/choose a GCP project, enable billing.
#   2. Enable the Vertex AI API:
#        https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
#   3. Authenticate, EITHER:
#        (a) Service account -- no gcloud CLI needed:
#            - IAM & Admin > Service Accounts > create
#            - grant the role "Vertex AI User"
#            - create a JSON key, save it OUTSIDE the repo
#            - set GOOGLE_APPLICATION_CREDENTIALS below
#        (b) gcloud CLI:
#            gcloud auth application-default login
#            (then GOOGLE_APPLICATION_CREDENTIALS can stay empty)

# Your GCP project id (not the project *number*, not the display name).
GOOGLE_CLOUD_PROJECT=

# Vertex region. us-central1 has the widest model availability.
GOOGLE_CLOUD_LOCATION=us-central1

# Absolute path to a service-account JSON key. Leave empty if using gcloud ADC.
# Keep this file OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=


# ===========================================================================
# OPTIONAL -- Gemini Developer API
# ===========================================================================
# Kept only for reference. VERIFIED NOT USABLE for this project: every model
# returns 400 "Logprobs is not enabled for this model" on this surface, while
# returning 200 for ordinary generation. Changing the model does not help.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ===========================================================================
# OPTIONAL -- local backends
# ===========================================================================
# No API key needed for llama.cpp or vLLM; they are addressed by URL in
# configs/models.yaml. Override only if you run them elsewhere.
#
# LLAMACPP_ENDPOINT=http://localhost:8080/completion
# VLLM_ENDPOINT=http://localhost:8000/v1/completions
