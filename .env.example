# Copy this file to .env and fill in your values:
#     cp .env.example .env          (PowerShell:  Copy-Item .env.example .env)
#
# .env is gitignored and must never be committed. Real environment variables
# take precedence over anything set here, so you can also just export a key.
# Scripts load .env automatically -- no python-dotenv dependency needed.


# ---------------------------------------------------------------------------
# REQUIRED when configs/models.yaml has `backend: gemini` (the default)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
#
# NOTE ON MODEL CHOICE: this project needs token log-probabilities.
# Gemini 2.5 models (gemini-2.5-flash, gemini-2.5-pro) support them.
# Gemini 3.x models (gemini-3-flash, gemini-3-pro) DO NOT -- they either reject
# the request or return no logprobsResult. The model itself is set in
# configs/models.yaml, not here.
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL -- only needed for the local backends
# ---------------------------------------------------------------------------
# No API key is required for llama.cpp or vLLM; they are addressed by URL in
# configs/models.yaml. Override the URLs here only if you run them elsewhere.
#
# LLAMACPP_ENDPOINT=http://localhost:8080/completion
# VLLM_ENDPOINT=http://localhost:8000/v1/completions
