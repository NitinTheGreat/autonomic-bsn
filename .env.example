# Copy this file to .env and fill in what you need:
#     cp .env.example .env          (PowerShell:  Copy-Item .env.example .env)
#
# .env is gitignored and must never be committed. Real environment variables
# take precedence over anything set here. Scripts load .env automatically --
# no python-dotenv dependency needed.


# ===========================================================================
# BACKEND SELECTION
# ===========================================================================
# Overrides `backend:` in configs/models.yaml, so you can switch stacks
# without editing a tracked file.
#
#   openai      TRUE logprobs        (default)
#   llamacpp    TRUE logprobs        local, free
#   vllm        TRUE logprobs        local, free
#   anthropic   NO logprobs -- self-consistency sampling; must be chosen
#               explicitly and is refused while require_logprobs: true
#   vertex      PAUSED pending credentials
#   gemini      PAUSED -- Developer API rejects logprobs on every model
#   auto        walk fallback_order (openai -> llamacpp -> vllm)
BSN_BACKEND=openai


# ===========================================================================
# REQUIRED for the default backend
# ===========================================================================
# https://platform.openai.com/api-keys
# The model name lives in configs/models.yaml -- confirm it against OpenAI's
# current model list, since names change and are deprecated on a rolling basis.
OPENAI_API_KEY=


# ===========================================================================
# OPTIONAL -- Anthropic (self-consistency, NOT logprobs)
# ===========================================================================
# https://console.anthropic.com/settings/keys
#
# The Messages API has no logprobs/top_logprobs -- no parameter, no model.
# This backend estimates confidence by sampling the same prompt k times
# (default k=10, temperature 0.7) and using the vote fraction per label.
# Results are tagged confidence_method="self_consistency" and MUST NOT be
# pooled with logprob results. It costs k x inference. Robustness check only.
#
# To use it you must select it explicitly AND set require_logprobs: false in
# configs/models.yaml -- otherwise the run refuses, by design.
ANTHROPIC_API_KEY=


# ===========================================================================
# PAUSED -- Vertex AI (Google Cloud)
# ===========================================================================
# Parked pending credentials. The backend code is implemented and verified
# against mocks, but has never been run live. See walkthrough/phase1.md 3.2.
#
# Setup when you return to it:
#   1. GCP project with billing enabled
#   2. Enable the Vertex AI API:
#        https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
#   3. Either a service-account JSON key with the "Vertex AI User" role
#      (set GOOGLE_APPLICATION_CREDENTIALS, keep the file OUTSIDE the repo),
#      or `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=


# ===========================================================================
# PAUSED -- Gemini Developer API
# ===========================================================================
# VERIFIED NOT USABLE for this project: every model returns
# 400 "Logprobs is not enabled for this model" on this surface, while
# returning 200 for ordinary generation. Changing the model does not help.
# Kept only so the finding is not rediscovered the hard way.
GEMINI_API_KEY=


# ===========================================================================
# OPTIONAL -- local backends
# ===========================================================================
# No API key needed for llama.cpp or vLLM; they are addressed by URL in
# configs/models.yaml. Override only if you run them elsewhere.
#
# LLAMACPP_ENDPOINT=http://localhost:8080/completion
# VLLM_ENDPOINT=http://localhost:8000/v1/completions
